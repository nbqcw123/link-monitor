# link-monitor 服务端配置（复制为 .env 后填写）
# 生成管理员口令哈希（不存明文）：
#   python3 scripts/set_admin_password.py --target env --password '你的密码'
# 也可以直接用 Docker 跑：
#   docker compose up -d

# 监听
PORT=8801
HOST=0.0.0.0

# 管理员账号（口令只保存 PBKDF2 哈希）
ADMIN_USER=admin
ADMIN_PASS_HASH=

# 登录有效期（小时）
SESSION_HOURS=12

# GitHub 推送（保存时自动提交 resources.json）
# 建议用 fine-grained token，只授权本仓库 Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=nbqcw123/link-monitor
GITHUB_BRANCH=main
GITHUB_PATH=resources/resources.json

# NAS 访问 GitHub 需要走代理时填写，例如 http://192.168.10.7:7890
# 留空则直连
GITHUB_PROXY=

# 保存后是否立即重新生成 index.html
PUBLISH_ON_SAVE=1

# 1 = 连首页也要登录（完全私有）
# 0 = 首页公开，仅管理页与写接口需要登录（推荐，方便局域网/公网展示）
PROTECT_ALL=0

# 用 HTTPS 反向代理时设为 1，Cookie 会加 Secure
COOKIE_SECURE=0

# 设为 1 打印访问日志（排查用）
ACCESS_LOG=0
